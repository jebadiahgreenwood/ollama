@@ -934,6 +934,9 @@ llama_model * llama_model_create(llama_model_loader & ml, const llama_model_para
 
 // model must inherit from this
 struct llama_model_base : public llama_model {
+    // EmberGate: <arch>.layer_schedule (see llama-model.cpp)
+    void apply_layer_schedule(llama_model_loader & ml);
+
     friend struct llama_model;
 
     llama_model * model;
