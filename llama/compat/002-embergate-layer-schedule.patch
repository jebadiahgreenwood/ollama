     vocab.load(ml, kv);
 }
 
+// EmberGate (R5/S1): optional <arch>.layer_schedule = array of FILE trunk layer indices, one per trunk POSITION.
+// The trunk then runs those layers in that order with weights shared (no copies); each position is its own layer
+// index for every cache (KV, conv + recurrent state), because a repeated recurrent pass needs its own state.
+// MTP/NextN layers stay after the trunk. Absent key: nothing changes.
+void llama_model_base::apply_layer_schedule(llama_model_loader & ml) {
+    std::vector<uint32_t> sched;
+    if (!ml.get_arr(LLM_KV_LAYER_SCHEDULE, sched, false)) {
+        return;
+    }
+    const std::string key = LLM_KV(arch)(LLM_KV_LAYER_SCHEDULE);
+    const uint32_t n_file = hparams.n_layer();
+    const uint32_t n_next = hparams.n_layer_nextn;
+    if (sched.empty()) {
+        throw std::runtime_error(format("%s is present but empty: list the file trunk layer indices to run "
+            "(0..%u), or remove the key", key.c_str(), n_file - 1));
+    }
+    if (sched.size() + n_next > LLAMA_MAX_LAYERS) {
+        throw std::runtime_error(format("%s has %zu positions; with %u MTP layer(s) that exceeds LLAMA_MAX_LAYERS = %d",
+            key.c_str(), sched.size(), n_next, LLAMA_MAX_LAYERS));
+    }
+    for (size_t p = 0; p < sched.size(); ++p) {
+        if (sched[p] >= n_file) {
+            throw std::runtime_error(format("%s[%zu] = %u, but the file has %u trunk layers (0..%u); "
+                "MTP layers (%u..%u) are kept after the trunk automatically and must not be listed",
+                key.c_str(), p, sched[p], n_file, n_file - 1, n_file, hparams.n_layer_all - 1));
+        }
+    }
+    for (uint32_t il = 0; arch == LLM_ARCH_DEEPSEEK41 && il < hparams.n_layer_all; ++il) {
+        if (hparams.dsv41_kv_src[il] >= 0 || hparams.dsv41_topk_src[il] >= 0) {
+            throw std::runtime_error(format("%s: layer %u references another layer (dsv41_kv_src = %d, dsv41_topk_src = %d); "
+                "a schedule does not remap layer references yet; remove the key",
+                key.c_str(), il, hparams.dsv41_kv_src[il], hparams.dsv41_topk_src[il]));
+        }
+    }
+    if (hparams.n_layer_decision > 0) {
+        throw std::runtime_error(format("%s: this model has %u decision-head layer(s) after the trunk; a schedule does "
+            "not place them yet; remove the key", key.c_str(), hparams.n_layer_decision));
+    }
+    if (hparams.n_layer_dense_lead > 0 || hparams.n_layer_kv_from_start >= 0 || hparams.router_layer >= 0) {
+        throw std::runtime_error(format("%s: arch %s uses layer-index scalars (n_layer_dense_lead = %u, "
+            "n_layer_kv_from_start = %d, router_layer = %d) that a schedule does not remap; remove the key",
+            key.c_str(), arch_name().c_str(), hparams.n_layer_dense_lead, hparams.n_layer_kv_from_start, hparams.router_layer));
+    }
+
+    pimpl->hparams_file   = hparams;
+    pimpl->layer_schedule = sched;
+
+    const uint32_t n_pos = (uint32_t) sched.size();
+    // position -> file layer, MTP appended
+    std::vector<uint32_t> src(n_pos + n_next);
+    for (uint32_t p = 0; p < n_pos;  ++p) { src[p] = sched[p]; }
+    for (uint32_t k = 0; k < n_next; ++k) { src[n_pos + k] = n_file + k; }
+
+    auto remap = [&](auto & arr) {
+        const auto orig = arr;
+        for (size_t p = 0; p < src.size(); ++p) {
+            arr[p] = orig[src[p]];
+        }
+    };
+    remap(hparams.n_head_arr);
+    remap(hparams.n_head_kv_arr);
+    remap(hparams.n_ff_arr);
+    remap(hparams.n_ff_exp_arr);
+    remap(hparams.n_expert_used_arr);
+    remap(hparams.rope_pattern);
+    remap(hparams.is_swa_impl);
+    remap(hparams.is_recr_impl);
+    remap(hparams.xielu_alpha_n);
+    remap(hparams.xielu_alpha_p);
+    remap(hparams.xielu_beta);
+    remap(hparams.xielu_eps);
+    remap(hparams.is_indexer_full_impl);
+    remap(hparams.dsv4_compress_ratios);
+    remap(hparams.deepstack_mapping_arr);
+    remap(hparams.swiglu_clamp_exp);
+    remap(hparams.swiglu_clamp_shexp);
+    {
+        const auto orig = hparams.is_ple_impl;
+        for (size_t p = 0; p < src.size(); ++p) {
+            hparams.is_ple_impl[p] = orig[src[p]];
+        }
+    }
+
+    hparams.n_layer_file = n_file;
+    hparams.n_layer_all  = n_pos + n_next;
+
+    std::string s;
+    for (uint32_t p = 0; p < n_pos; ) {
+        uint32_t q = p;
+        while (q + 1 < n_pos && sched[q + 1] == sched[q] + 1) { ++q; }
+        s += (s.empty() ? "" : ",") + (q == p ? std::to_string(sched[p]) : std::to_string(sched[p]) + "-" + std::to_string(sched[q]));
+        p = q + 1;
+    }
+    LLAMA_LOG_INFO("%s: %s: %u trunk positions over %u file trunk layers [%s], %u MTP layer(s) after\n",
+        __func__, key.c_str(), n_pos, n_file, s.c_str(), n_next);
+}
+
 bool llama_model_base::load_tensors(llama_model_loader & ml) {
     const auto & split_mode   = params.split_mode;
     const bool use_mlock      = params.load_mode == LLAMA_LOAD_MODE_MLOCK || params.load_mode == LLAMA_LOAD_MODE_MMAP_MLOCK;
     const auto & tensor_split = params.tensor_split;
 
+    // layer schedule: tensors are created once per FILE layer (file names, file indices), so switch to the
+    // file's hparams here and expand to positions right before done_getting_tensors()
+    const bool has_schedule = !pimpl->layer_schedule.empty();
+    if (has_schedule) {
+        std::swap(hparams, pimpl->hparams_file);
+    }
+
     const int n_layer_all = hparams.n_layer_all;
     const int n_gpu_layers = this->n_gpu_layers();
 
@@ -1878,6 +1988,21 @@ bool llama_model_base::load_tensors(llama_model_loader & ml) {
             }
         }
     }
+    if (has_schedule) {
+        std::swap(hparams, pimpl->hparams_file); // back to positions
+        const uint32_t n_file = pimpl->hparams_file.n_layer();
+        const uint32_t n_pos  = hparams.n_layer();
+        const uint32_t n_next = hparams.n_layer_nextn;
+        std::vector<llama_layer>               layers_pos(n_pos + n_next);
+        std::vector<llama_model::impl::layer_dev> dev_pos(n_pos + n_next);
+        for (uint32_t p = 0; p < n_pos + n_next; ++p) {
+            const uint32_t f = p < n_pos ? pimpl->layer_schedule[p] : n_file + (p - n_pos);
+            layers_pos[p] = layers.at(f);         // same ggml tensors: weights shared
+            dev_pos[p]    = pimpl->dev_layer.at(f); // caches live with their layer's weights
+        }
+        layers           = std::move(layers_pos);
+        pimpl->dev_layer = std::move(dev_pos);
+    }
 
     ml.done_getting_tensors();
 
