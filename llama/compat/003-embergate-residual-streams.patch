+// EmberGate R5/S2: n-branch gated residual (the "4-branch residual" of research/arch-experiments/archmods.py).
+// The residual S is [n_embd, n, T]; the first layer fans the embedding out n times. Per sub-block (mixer, MLP):
+//   read : Rh = rms_norm(S) * gain;  v = Rh as [n*n_embd, T];  G = 2*sigmoid(W_u silu(W_a v / n))
+//          x  = mean_i (G * Rh)_i  (the sub-block input);     s = 2*sigmoid(W_v v / n)  [n, T]
+//   write: S_i += s_i * y          (y = the unchanged sub-block output)
+// After the last layer h = mean_i S_i goes to output_norm, and output_norm(h) is also the MTP head's input
+// (t_h_nextn), as in HF where archmods.MergeNorm merges before the final norm. Op-for-op reference, equal to
+// archmods.HCDecoderLayer in fp32: research/arch-experiments/r5/hc_reference.py.
+
+// mean over the branch axis; for n = 4 summed pairwise like archmods._branch_mean
+static ggml_tensor * hc_branch_mean(ggml_context * ctx, ggml_tensor * x) {
+    const int64_t nb = x->ne[1];
+    auto br = [&](int64_t i) {
+        return ggml_view_2d(ctx, x, x->ne[0], x->ne[2], x->nb[2], i*x->nb[1]);
+    };
+    ggml_tensor * acc = nullptr;
+    if (nb == 4) {
+        acc = ggml_add(ctx, ggml_add(ctx, br(0), br(1)), ggml_add(ctx, br(2), br(3)));
+    } else {
+        acc = ggml_add(ctx, br(0), br(1));
+        for (int64_t i = 2; i < nb; ++i) {
+            acc = ggml_add(ctx, acc, br(i));
+        }
+    }
+    return ggml_scale(ctx, acc, 1.0f / (float) nb);
+}
+
+ggml_tensor * llama_model_qwen35::graph::build_hc_read(
+        ggml_tensor *  S,
+        ggml_tensor *  gain,
+        ggml_tensor *  w_a,
+        ggml_tensor *  w_u,
+        ggml_tensor *  w_v,
+        ggml_tensor ** s,
+        int            il) {
+    const int64_t nb = S->ne[1];
+    const int64_t nt = S->ne[2];
+
+    ggml_tensor * rh = ggml_mul(ctx0, ggml_rms_norm(ctx0, S, hparams.f_norm_rms_eps), gain);
+    cb(rh, "hc_norm", il);
+
+    ggml_tensor * v = ggml_reshape_2d(ctx0, rh, n_embd*nb, nt);
+
+    ggml_tensor * lo = ggml_silu(ctx0, ggml_scale(ctx0, ggml_mul_mat(ctx0, w_a, v), 1.0f / (float) nb));
+    ggml_tensor * g  = ggml_scale(ctx0, ggml_sigmoid(ctx0, ggml_mul_mat(ctx0, w_u, lo)), 2.0f);
+    cb(g, "hc_gate", il);
+
+    ggml_tensor * x = hc_branch_mean(ctx0, ggml_mul(ctx0, ggml_reshape_3d(ctx0, g, n_embd, nb, nt), rh));
+    cb(x, "hc_read", il);
+
+    *s = ggml_scale(ctx0, ggml_sigmoid(ctx0, ggml_scale(ctx0, ggml_mul_mat(ctx0, w_v, v), 1.0f / (float) nb)), 2.0f);
+    cb(*s, "hc_write_scale", il);
+
+    return x;
+}
+
+ggml_tensor * llama_model_qwen35::graph::build_hc_write(
+        ggml_tensor * S,
+        ggml_tensor * s,
+        ggml_tensor * y,
+        int           il) {
+    const int64_t nb = S->ne[1];
+    const int64_t nt = S->ne[2];
+
+    ggml_tensor * yb  = ggml_repeat_4d(ctx0, ggml_reshape_3d(ctx0, y, n_embd, 1, nt), n_embd, nb, nt, 1);
+    ggml_tensor * out = ggml_add(ctx0, S, ggml_mul(ctx0, yb, ggml_reshape_3d(ctx0, s, 1, nb, nt)));
+    cb(out, "hc_write", il);
+
+    return out;
+}
+
+ggml_tensor * llama_model_qwen35::graph::build_hc_trunk(
+        ggml_tensor *                inpL,
+        llm_graph_input_mem_hybrid * inp,
+        ggml_tensor *                inp_pos,
+        ggml_tensor *                inp_out_ids,
+        int *                        sections) {
+    const int64_t nb = hparams.n_residual_streams;
+
+    ggml_tensor * S = ggml_repeat_4d(ctx0, ggml_reshape_3d(ctx0, inpL, n_embd, 1, n_tokens), n_embd, nb, n_tokens, 1);
+    cb(S, "hc_init", -1);
+    ggml_build_forward_expand(gf, S);
+
+    for (int il = 0; il < n_layer; ++il) {
+        const auto & layer = model.layers[il];
+
+        if ((size_t) il < cparams.embeddings_layer_inp.size() && cparams.embeddings_layer_inp[il]) {
+            res->t_layer_inp[il] = hc_branch_mean(ctx0, S);
+            ggml_build_forward_expand(gf, res->t_layer_inp[il]);
+        }
+
+        ggml_tensor * s   = nullptr;
+        ggml_tensor * cur = build_hc_read(S, layer.hc_mix_gain, layer.hc_mix_w_a, layer.hc_mix_w_u, layer.hc_mix_w_v, &s, il);
+        ggml_build_forward_expand(gf, cur);
+
+        if (hparams.is_recr(il)) {
+            cur = build_layer_attn_linear(inp->get_recr(), cur, il);
+        } else {
+            cur = build_layer_attn(inp->get_attn(), cur, inp_pos, sections, il);
+        }
+
+        if (il == n_layer - 1 && crop_before_nextn(inp_out_ids)) {
+            cur = ggml_get_rows(ctx0, cur, inp_out_ids);
+            s   = ggml_get_rows(ctx0, s,   inp_out_ids);
+            S   = ggml_reshape_2d(ctx0, S, n_embd*nb, S->ne[2]);
+            S   = ggml_get_rows(ctx0, S, inp_out_ids);
+            S   = ggml_reshape_3d(ctx0, S, n_embd, nb, S->ne[1]);
+        }
+
+        S = build_hc_write(S, s, cur, il);
+        cb(S, "attn_residual", il);
+
+        cur = build_hc_read(S, layer.hc_mlp_gain, layer.hc_mlp_w_a, layer.hc_mlp_w_u, layer.hc_mlp_w_v, &s, il);
+        cur = build_layer_ffn(cur, il);
+
+        S = build_hc_write(S, s, cur, il);
+        S = build_cvec(S, il);  // a control vector [n_embd] broadcasts over the branches (moves their mean)
+        cb(S, "hc_l_out", il);
+    }
+
+    ggml_tensor * h = hc_branch_mean(ctx0, S);
+    cb(h, "hc_merge", -1);
+
+    return h;
+}
+
 std::pair<ggml_tensor *, ggml_tensor *> llama_model_qwen35::graph::build_qkvz(
                 ggml_tensor * input,
                         int   il) {
