diff --git a/src/models/qwen35.cpp b/src/models/qwen35.cpp
index 16594b23..2eb79dfd 100644
--- a/src/models/qwen35.cpp
+++ b/src/models/qwen35.cpp
@@ -159,6 +159,83 @@ void llama_model_qwen35::load_arch_tensors(llama_model_loader & ml) {
     for (int i = n_layer; i < n_layer_all; ++i) {
         load_block_mtp(i);
     }
+    load_hc_pass_sets(ml, trunk_flags);
+}
+
+// EmberGate T-052: the extra gate sets of <arch>.residual_gate_map (pass.k.hc_mix.* / pass.k.hc_mlp.*), same shapes and
+// forms as blk.N.hc_* (w_a + w_v, or the fused w_av of W-188). Each set goes in the buffer of the file layer whose
+// position reads it first. A file with pass.* tensors but no map is refused here, naming a tensor.
+void llama_model_qwen35::load_hc_pass_sets(llama_model_loader & ml, int flags) {
+    const auto & gmap  = residual_gate_map();
+    const std::string key = ml.llm_kv(LLM_KV_RESIDUAL_GATE_MAP);
+    const uint32_t n_file = hparams.n_layer(); // the file's hparams here (load_tensors swaps them in)
+    uint32_t n_sets = 0;
+    for (const uint32_t g : gmap) {
+        if (g >= n_file) { n_sets = std::max(n_sets, g - n_file + 1); }
+    }
+    for (const auto & [name, w] : ml.weights_map) {
+        if (name.rfind("pass.", 0) != 0) {
+            continue;
+        }
+        const uint32_t k = (uint32_t) std::strtoul(name.c_str() + 5, nullptr, 10);
+        if (gmap.empty()) {
+            throw std::runtime_error(format("the file has per-pass gate tensor '%s' but no %s: nothing would read it; "
+                "repack with add_residual_gates.py --per-pass on (writes the map) or --per-pass off (shared gates only)",
+                name.c_str(), key.c_str()));
+        }
+        if (k >= n_sets) {
+            throw std::runtime_error(format("the file has '%s' (pass set %u), but %s names %u pass set(s) "
+                "(values %u..%u): nothing would read it", name.c_str(), k, key.c_str(), n_sets, n_file,
+                n_file + (n_sets ? n_sets : 1) - 1));
+        }
+    }
+    hc_pass_sets.assign(n_sets, llama_layer{});
+    if (n_sets == 0) {
+        return;
+    }
+    const auto & sched = layer_schedule_positions();
+    const int64_t n_embd = hparams.n_embd;
+    const int64_t nb = hparams.n_residual_streams;
+    const int64_t nd = nb * n_embd;
+    const int64_t r  = hparams.residual_rank;
+    for (uint32_t k = 0; k < n_sets; ++k) {
+        const uint32_t p = (uint32_t) (std::find(gmap.begin(), gmap.end(), n_file + k) - gmap.begin());
+        const int f = (int) sched.at(p);
+        const bool fused = ml.get_tensor_meta(tn(LLM_TENSOR_HC_PASS_MIX_W_AV, k).str().c_str()) != nullptr;
+        std::vector<llm_tensor> need = { LLM_TENSOR_HC_PASS_MIX_GAIN, LLM_TENSOR_HC_PASS_MIX_W_U,
+                                         LLM_TENSOR_HC_PASS_MLP_GAIN, LLM_TENSOR_HC_PASS_MLP_W_U };
+        if (fused) {
+            need.insert(need.end(), { LLM_TENSOR_HC_PASS_MIX_W_AV, LLM_TENSOR_HC_PASS_MLP_W_AV });
+        } else {
+            need.insert(need.end(), { LLM_TENSOR_HC_PASS_MIX_W_A, LLM_TENSOR_HC_PASS_MIX_W_V,
+                                      LLM_TENSOR_HC_PASS_MLP_W_A, LLM_TENSOR_HC_PASS_MLP_W_V });
+        }
+        for (const llm_tensor t : need) {
+            const std::string nm = tn(t, k).str();
+            if (ml.get_tensor_meta(nm.c_str()) == nullptr) {
+                throw std::runtime_error(format("%s[%u] = %u reads pass set %u (first reader; file layer %d), but the "
+                    "file has no '%s'. A %s pass set is gain + w_u + %s for both hc_mix and hc_mlp",
+                    key.c_str(), p, n_file + k, k, f, nm.c_str(), fused ? "fused" : "plain",
+                    fused ? "w_av" : "w_a + w_v"));
+            }
+        }
+        auto & S = hc_pass_sets[k];
+        S.hc_mix_gain = create_tensor_on_layer(tn(LLM_TENSOR_HC_PASS_MIX_GAIN, k), { n_embd, nb }, flags, f);
+        S.hc_mix_w_u  = create_tensor_on_layer(tn(LLM_TENSOR_HC_PASS_MIX_W_U,  k), { r, nd },      flags, f);
+        S.hc_mlp_gain = create_tensor_on_layer(tn(LLM_TENSOR_HC_PASS_MLP_GAIN, k), { n_embd, nb }, flags, f);
+        S.hc_mlp_w_u  = create_tensor_on_layer(tn(LLM_TENSOR_HC_PASS_MLP_W_U,  k), { r, nd },      flags, f);
+        if (fused) {
+            S.hc_mix_w_av = create_tensor_on_layer(tn(LLM_TENSOR_HC_PASS_MIX_W_AV, k), { nd, r + nb }, flags, f);
+            S.hc_mlp_w_av = create_tensor_on_layer(tn(LLM_TENSOR_HC_PASS_MLP_W_AV, k), { nd, r + nb }, flags, f);
+        } else {
+            S.hc_mix_w_a  = create_tensor_on_layer(tn(LLM_TENSOR_HC_PASS_MIX_W_A,  k), { nd, r },  flags, f);
+            S.hc_mix_w_v  = create_tensor_on_layer(tn(LLM_TENSOR_HC_PASS_MIX_W_V,  k), { nd, nb }, flags, f);
+            S.hc_mlp_w_a  = create_tensor_on_layer(tn(LLM_TENSOR_HC_PASS_MLP_W_A,  k), { nd, r },  flags, f);
+            S.hc_mlp_w_v  = create_tensor_on_layer(tn(LLM_TENSOR_HC_PASS_MLP_W_V,  k), { nd, nb }, flags, f);
+        }
+    }
+    LLAMA_LOG_INFO("%s: %s: %u pass gate set(s) loaded (%s)\n", __func__, key.c_str(), n_sets,
+        ml.get_tensor_meta(tn(LLM_TENSOR_HC_PASS_MIX_W_AV, 0).str().c_str()) ? "fused w_av" : "w_a + w_v");
 }
 
