+// EmberGate T-052: optional <arch>.residual_gate_map = array of gate-set indices, one per trunk POSITION of
+// <arch>.layer_schedule. g < n (n = file trunk layers) reads file layer g's blk.g.hc_* gates (without the key every
+// position reads its own file layer's: today's behaviour); g >= n reads the extra set pass.(g - n).hc_*, so a
+// repeated pass can carry its own trained read gates (archmods B{b}.T{j}). Absent key: nothing changes.
+void llama_model_base::apply_residual_gate_map(llama_model_loader & ml) {
+    std::vector<uint32_t> gmap;
+    if (!ml.get_arr(LLM_KV_RESIDUAL_GATE_MAP, gmap, false)) {
+        return;
+    }
+    const std::string key  = LLM_KV(arch)(LLM_KV_RESIDUAL_GATE_MAP);
+    const std::string skey = LLM_KV(arch)(LLM_KV_LAYER_SCHEDULE);
+    if (hparams.n_residual_streams <= 1) {
+        throw std::runtime_error(format("%s is present but %s is %u: a gate map needs the n-branch residual "
+            "(blk.N.hc_* gates); remove the key or add the gates", key.c_str(),
+            LLM_KV(arch)(LLM_KV_RESIDUAL_STREAMS).c_str(), hparams.n_residual_streams));
+    }
+    if (pimpl->layer_schedule.empty()) {
+        throw std::runtime_error(format("%s is present but %s is not: the map has one entry per schedule position, "
+            "and without a schedule every layer runs once with its own gates; remove the key", key.c_str(), skey.c_str()));
+    }
+    const auto & sched = pimpl->layer_schedule;
+    const uint32_t n_file = pimpl->hparams_file.n_layer();
+    if (gmap.size() != sched.size()) {
+        throw std::runtime_error(format("%s has %zu entries but %s has %zu positions: one gate set per position",
+            key.c_str(), gmap.size(), skey.c_str(), sched.size()));
+    }
+    uint32_t n_sets = 0;
+    for (const uint32_t g : gmap) {
+        if (g >= n_file) { n_sets = std::max(n_sets, g - n_file + 1); }
+    }
+    if (n_sets > LLAMA_MAX_LAYERS) {
+        throw std::runtime_error(format("%s names pass set %u; at most %d pass sets are supported",
+            key.c_str(), n_sets - 1, LLAMA_MAX_LAYERS));
+    }
+    for (uint32_t k = 0; k < n_sets; ++k) {
+        if (std::find(gmap.begin(), gmap.end(), n_file + k) == gmap.end()) {
+            throw std::runtime_error(format("%s names pass sets up to pass.%u, but no position reads pass.%u "
+                "(value %u): its tensors would be unused; renumber the sets 0..%u in order of use",
+                key.c_str(), n_sets - 1, k, n_file + k, n_sets - 2));
+        }
+    }
+    pimpl->residual_gate_map = gmap;
+
+    std::string s;
+    uint32_t n_own = 0, n_other = 0;
+    for (uint32_t p = 0; p < gmap.size(); ++p) {
+        const uint32_t g = gmap[p];
+        if (g == sched[p]) { ++n_own; continue; }
+        ++n_other;
+        if (s.size() < 400) {
+            s += format("%s%u:%s", s.empty() ? "" : " ", p,
+                g >= n_file ? format("pass.%u", g - n_file).c_str() : format("blk.%u", g).c_str());
+        }
+    }
+    LLAMA_LOG_INFO("%s: %s: %u positions read their own layer's gates, %u read another set (%u pass sets) [%s%s]\n",
+        __func__, key.c_str(), n_own, n_other, n_sets, s.c_str(), s.size() >= 400 ? " ..." : "");
+}
+
+const std::vector<uint32_t> & llama_model_base::layer_schedule_positions() const {
+    return pimpl->layer_schedule;
+}
+
+const std::vector<uint32_t> & llama_model_base::residual_gate_map() const {
+    return pimpl->residual_gate_map;
+}
