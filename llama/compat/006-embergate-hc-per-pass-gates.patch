@@ -1999,6 +2068,21 @@ bool llama_model_base::load_tensors(llama_model_loader & ml) {
             const uint32_t f = p < n_pos ? pimpl->layer_schedule[p] : n_file + (p - n_pos);
             layers_pos[p] = layers.at(f);         // same ggml tensors: weights shared
             dev_pos[p]    = pimpl->dev_layer.at(f); // caches live with their layer's weights
+            // T-052: a position whose gate-map entry names another set reads that set's hc_* gates
+            const uint32_t g = (p < n_pos && !pimpl->residual_gate_map.empty()) ? pimpl->residual_gate_map[p] : f;
+            if (g != f) {
+                const llama_layer & gs = g < n_file ? layers.at(g) : hc_pass_sets.at(g - n_file);
+                auto & L = layers_pos[p];
+                L.hc_mix_gain = gs.hc_mix_gain; L.hc_mix_w_a = gs.hc_mix_w_a; L.hc_mix_w_u = gs.hc_mix_w_u;
+                L.hc_mix_w_v  = gs.hc_mix_w_v;  L.hc_mix_w_av = gs.hc_mix_w_av;
+                L.hc_mlp_gain = gs.hc_mlp_gain; L.hc_mlp_w_a = gs.hc_mlp_w_a; L.hc_mlp_w_u = gs.hc_mlp_w_u;
+                L.hc_mlp_w_v  = gs.hc_mlp_w_v;  L.hc_mlp_w_av = gs.hc_mlp_w_av;
+                if (L.hc_mix_gain == nullptr || L.hc_mlp_gain == nullptr) {
+                    throw std::runtime_error(format("%s[%u] = %u: that gate set was not loaded (the arch loader "
+                        "creates pass.k.hc_* only for qwen35 with residual_streams > 1)",
+                        LLM_KV(arch)(LLM_KV_RESIDUAL_GATE_MAP).c_str(), p, g));
+                }
+            }
         }
         layers           = std::move(layers_pos);
         pimpl->dev_layer = std::move(dev_pos);
@@ -3987,6 +4071,14 @@ ggml_tensor * llama_model_base::create_tensor(const LLM_TN_IMPL & tn, const std:
     return create_tensor(*ml, tn, ne, flags);
 }
 
+ggml_tensor * llama_model_base::create_tensor_on_layer(const LLM_TN_IMPL & tn, const std::initializer_list<int64_t> & ne, int flags, int il_dev) {
+    GGML_ASSERT(ml != nullptr);
+    GGML_ASSERT(il_dev >= 0 && (size_t) il_dev < pimpl->dev_layer.size());
+    return ml->create_tensor(
+        hparams, &pimpl->cpu_buft_list, pimpl->dev_input.buft_list, pimpl->dev_output.buft_list,
+        pimpl->dev_layer.at(il_dev).buft_list, tn, ne, flags);
+}
